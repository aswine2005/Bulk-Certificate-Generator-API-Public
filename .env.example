# Copy to .env and adjust. Every value shown is the default.

# Any SQLAlchemy URL. PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://certs:certs@localhost:5432/certs
DATABASE_URL=sqlite:///./data/app.db

# Generated PDFs are written to <STORAGE_DIR>/<job_id>/<certificate_id>.pdf
STORAGE_DIR=./data/certificates

# Base URL encoded in each certificate's QR code (points at /api/v1/verify/{code})
PUBLIC_BASE_URL=http://localhost:8000

# "thread" = background thread pool, "inline" = generate inside the request (debugging)
QUEUE_BACKEND=thread
WORKER_THREADS=2

# Certificates committed per batch (also how often progress updates)
BATCH_SIZE=50

MAX_RECIPIENTS_PER_JOB=10000
LOG_LEVEL=INFO
